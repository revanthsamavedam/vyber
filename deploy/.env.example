# Copy to .env in this directory, fill in, chmod 600 .env — never commit it.
# Host directory (on the EBS volume) holding vyber.db, workspaces, traces.
VYBER_HOST_DATA=/home/ec2-user/vyber-data

# The model — your Azure OpenAI deployment, in Pydantic AI's syntax.
# Leave empty to run on the placeholder test model.
VYBER_MODEL=azure:your-deployment-name
# Azure OpenAI connection details, per Pydantic AI's Azure provider:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Optional: move the DB to Postgres later without touching the images.
# VYBER_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/vyber

# Authentication. Demo mode is for local development ONLY — switch to
# jwt (JWKS-validated) before real users. Point these at your identity
# provider or your organization's JWT authorization service.
# VYBER_AUTH_MODE=jwt
# VYBER_JWT_JWKS_URL=https://issuer.example/.well-known/jwks.json
# VYBER_JWT_ISSUER=https://issuer.example
# VYBER_JWT_AUDIENCE=vyber-api
# VYBER_JWT_USER_CLAIM=upn

